APP_NAME=NavlunIQ
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Europe/Istanbul
APP_LOCALE=tr
APP_FALLBACK_LOCALE=tr
APP_URL=http://localhost

# Şirket ve Resmi Sözleşme Bilgileri (Dinamik Değişkenler)
COMPANY_NAME=
COMPANY_TAX_OFFICE=
COMPANY_TAX_NO=
COMPANY_MERSIS_NO=
COMPANY_ADDRESS=
COMPANY_PHONE=
COMPANY_EMAIL=

# Veritabanı Ayarları (XAMPP MySQL Uyumlu)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=navluniq
DB_USERNAME=
DB_PASSWORD=

# Cache, Session ve Queue Ayarları (Redis Desteği)
BROADCAST_CONNECTION=log
CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120

MEMCACHED_HOST=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

# İlk yönetici yalnızca bu üç değer eksiksizse oluşturulur.
# Parolaları kaynak koda veya Git deposuna yazmayın.
ADMIN_INIT_EMAIL=
ADMIN_INIT_PASSWORD=
ADMIN_INIT_PHONE=


# Natro Posta Sunucusu Uyumlu SMTP Ayarları
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=info@example.com
MAIL_FROM_NAME=NavlunIQ

# NVİ (Nüfus ve Vatandaşlık İşleri) Doğrulama Ayarları
NVI_MOCK_ENABLED=true
NVI_API_URL=

# GİB (Gelir İdaresi Başkanlığı) Vergi No Doğrulama Ayarları
GIB_MOCK_ENABLED=true
GIB_API_URL=

# NetGSM Resmi İletişim Entegrasyonu (OTP SMS & Meta WhatsApp API)
NETGSM_USER=
NETGSM_PASS=
NETGSM_HEADER=
NETGSM_WHATSAPP_APP_ID=
NETGSM_WHATSAPP_SECRET=

# PayTR Güvenli Havuz (Escrow) Ödeme Entegrasyonu
PAYTR_SANDBOX_MODE=true
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=

# Harita Servisleri Entegrasyonu (Adres Tamamlama ve Canlı Takip)
GOOGLE_PLACES_API_KEY=
MAPBOX_API_KEY=

# Çoklu Yapay Zeka ve LLM API Yönetimi (Kota Aşımı Fallback Destekli)
ACTIVE_AI_PROVIDER=gemini
CLAUDE_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
KIMI_API_KEY=

# Güvenlik ve Sınır Değer Ayarları
ADMIN_OTP_REQUIRED=true
MAX_LOGIN_ATTEMPTS=5
RATE_LIMIT_IP_BAN_DURATION_MINUTES=15

# Otonom Kazıma Mikro-servis Güvenlik Anahtarı (API Token)
SCRAPER_API_TOKEN=

# Aktif Yapay Zeka Sağlayıcısı (Öncelikli Başlangıç: gemini)

# Google AI Studio Gemini API Yapılandırması (Sizin Gerçek Anahtarınız)

# Moonshot AI (Kimi) API Yapılandırması (Ücretsiz deneme kodunuz varsa buraya ekleyebilirsiniz)

# Claude API Yapılandırması
AI_FREE_ONLY=true
AI_PAID_ENABLED=false

APP_NAME=NavlunIQ
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Europe/Istanbul
APP_LOCALE=tr
APP_FALLBACK_LOCALE=tr
APP_URL=http://navluniq.test

# Canlı ortamda: APP_ENV=production, APP_DEBUG=false, SESSION_SECURE_COOKIE=true
LOG_CHANNEL=stack
LOG_LEVEL=debug

# Şirket künyesi (sözleşme metinleri, iletişim sayfası ve e-posta altbilgisi)
# Şirket künyesi panelden yönetilir (Sistem Ayarları → Ödeme altyapısı); buradaki değerler yalnız panel boşsa kullanılır.
COMPANY_NAME=
COMPANY_TAX_OFFICE=
COMPANY_TAX_NO=
COMPANY_MERSIS_NO=
COMPANY_ADDRESS=
COMPANY_PHONE=
COMPANY_EMAIL=
LEGAL_DOCUMENT_VERSION=1.0
LEGAL_EFFECTIVE_DATE=

# Veritabanı
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=navluniq
DB_USERNAME=
DB_PASSWORD=

# Önbellek, oturum, kuyruk
BROADCAST_CONNECTION=log
CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
FILESYSTEM_DISK=local

# İlk yönetici yalnızca üç değer de doluysa oluşturulur (php artisan db:seed).
ADMIN_INIT_EMAIL=
ADMIN_INIT_PASSWORD=
ADMIN_INIT_PHONE=

# E-posta (OTP kodları ve bildirimler bu hesaptan gider)
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# PayTR (iFrame API). Anahtarlar boşken ödeme sayfası "aktivasyon aşamasında" gösterir.
PAYMENT_PROVIDER=iyzico
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
PAYTR_SANDBOX_MODE=true

# NetGSM SMS
NETGSM_USER=
NETGSM_PASS=
NETGSM_HEADER=

# NVİ kimlik doğrulama (KPS Public servisi; kapatmak için false)
NVI_ENABLED=true

# WhatsApp ilan toplama servisi (whatsapp-scraper-daemon) için paylaşılan gizli anahtar
SCRAPER_API_TOKEN=   # isteğe bağlı; anahtar panelden üretilir (Dış Kaynak İlanları → Kaynaklar ve telefon)

# İlan metni ayrıştırma sağlayıcıları (önce regex, sonra aktif sağlayıcı)
ACTIVE_AI_PROVIDER=gemini
AI_FREE_ONLY=true
AI_PAID_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5
KIMI_API_KEY=
KIMI_MODEL=moonshot-v1-8k

# Laravel webhook ucu (canlı: https://alanadiniz.com/api/v1/webhook/whatsapp-scraper)
NAVLUNIQ_API_URL=
# Laravel .env içindeki SCRAPER_API_TOKEN ile birebir aynı olmalı
SCRAPER_API_TOKEN=
# Dinlenecek WhatsApp grup kimlikleri, virgülle ayrılmış (örn. 1203630xxxxx@g.us)
WHATSAPP_ALLOWED_GROUP_IDS=
# Oturum dosyası (tek dosya, 0600 izin)
WHATSAPP_AUTH_FILE=/var/lib/navluniq-whatsapp/auth.json
